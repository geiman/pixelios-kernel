SWEET HID touch: map panel pixels with the real panel size (the boot framebuffer AppleCLCD presents) instead of a hard-coded 1080x2400. On a panel larger than the presented 1125x2436 (raven 1440x3120, patch 0145) margin touches clamp to the nearest display edge and count as edge contacts. Panels of 1080x2400 (sweet, bluejay) map exactly as before.
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -367,6 +367,7 @@ protected:
 	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 2; }
 private:
 	IOLock *fLock;
+	int fPanelW, fPanelH;               /* boot framebuffer = panel pixels, the units of sweet_hid_touch() */
 	int fLogicalW, fLogicalH, fOffX, fOffY;
 	bool fDown[SWEET_TOUCH_FINGERS];
 	bool fEdge[SWEET_TOUCH_FINGERS];
@@ -433,11 +434,19 @@ SweetHIDTouch::start(IOService *provider)
 		return false;
 	}
 	int native = 0;
+	PE_Video video;
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
-	fLogicalW = native ? 1080 : 1125;
-	fLogicalH = native ? 2400 : 2436;
-	fOffX = (fLogicalW - 1080) / 2;
-	fOffY = (fLogicalH - 2400) / 2;
+	/*
+	 * The panel is the boot framebuffer AppleCLCD::start presents (SweetFramebuffer.cpp, the same PE_current_console call).
+	 * 1080x2400 (sweet, bluejay) if there is none, as before (patch 0147). Raven: 1440x3120, offsets negative (patch 0145).
+	 */
+	PE_current_console(&video);
+	fPanelW = video.v_width > 1 ? (int)video.v_width : 1080;
+	fPanelH = video.v_height > 1 ? (int)video.v_height : 2400;
+	fLogicalW = native ? fPanelW : 1125;
+	fLogicalH = native ? fPanelH : 2436;
+	fOffX = (fLogicalW - fPanelW) / 2;
+	fOffY = (fLogicalH - fPanelH) / 2;
 	/* The digitizer covers the main display (backboardd maps it 1:1). */
 	setProperty("DisplayIntegrated", kOSBooleanTrue);
 	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
@@ -458,22 +467,33 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
 	if (finger < 0 || finger >= SWEET_TOUCH_FINGERS) {
 		return;
 	}
-	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
-	y = y < 0 ? 0 : (y > 2399 ? 2399 : y);
+	x = x < 0 ? 0 : (x > fPanelW - 1 ? fPanelW - 1 : x);
+	y = y < 0 ? 0 : (y > fPanelH - 1 ? fPanelH - 1 : y);
+	/*
+	 * Panel pixels -> the presented 1125x2436 display (SweetFramebuffer.cpp). On a panel larger than that (raven) the
+	 * presented display is drawn 1:1 in its centre: a touch in the margin is clamped to the nearest display edge, so a
+	 * swipe that starts at the physical edge still starts at the display edge (home / app-switcher gestures).
+	 */
+	int lx = x + fOffX, ly = y + fOffY;
+	bool edge = x < SWEET_TOUCH_EDGE_PX || x > fPanelW - 1 - SWEET_TOUCH_EDGE_PX ||
+	    y < SWEET_TOUCH_EDGE_PX || y > fPanelH - 1 - SWEET_TOUCH_EDGE_PX ||
+	    /* near or past the display edge; on panels <= 1125x2436 this band lies inside the panel band above */
+	    lx < SWEET_TOUCH_EDGE_PX || lx > fLogicalW - 1 - SWEET_TOUCH_EDGE_PX ||
+	    ly < SWEET_TOUCH_EDGE_PX || ly > fLogicalH - 1 - SWEET_TOUCH_EDGE_PX;
+	lx = lx < 0 ? 0 : (lx > fLogicalW - 1 ? fLogicalW - 1 : lx);
+	ly = ly < 0 ? 0 : (ly > fLogicalH - 1 ? fLogicalH - 1 : ly);
 
 	IOLockLock(fLock);
 	bool was = fDown[finger];
-	/* Panel pixels -> the presented 1125x2436 display (SweetFramebuffer.cpp). */
-	IOFixed nx = (IOFixed)(((int64_t)(x + fOffX) << 16) / fLogicalW);
-	IOFixed ny = (IOFixed)(((int64_t)(y + fOffY) << 16) / fLogicalH);
+	IOFixed nx = (IOFixed)(((int64_t)lx << 16) / fLogicalW);
+	IOFixed ny = (IOFixed)(((int64_t)ly << 16) / fLogicalH);
 	bool moved = down && (nx != fX[finger] || ny != fY[finger]);
 	if (was == down && !moved) {
 		IOLockUnlock(fLock);
 		return;
 	}
 	if (!was && down) {
-		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x > 1079 - SWEET_TOUCH_EDGE_PX ||
-		    y < SWEET_TOUCH_EDGE_PX || y > 2399 - SWEET_TOUCH_EDGE_PX;
+		fEdge[finger] = edge;
 	}
 
 	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
