diff --git a/bsd/dev/sweet_mali_pt.h b/bsd/dev/sweet_mali_pt.h
--- a/bsd/dev/sweet_mali_pt.h
+++ b/bsd/dev/sweet_mali_pt.h
@@ -64,6 +64,53 @@ mali_va_alloc(struct mali_va *v, uint32_t npages, uint32_t align_pages)
 	return 0;
 }
 
+/*
+ * Executable mappings must not cross a 16 MB boundary: Linux panfrost (v6.12 panfrost_gem.c, panfrost_gem_open(),
+ * "the program counter is 24-bits") enforces this with no architecture check, and panfrost_drv.c matches
+ * arm,mali-valhall-jm [src]. v6.12's model table (panfrost_gpu.c) lists Valhall G57 IDs, not the G78, so this is the
+ * invariant of the closest Linux driver, adopted conservatively, not a statement that v6.12 drives the G78. Linux aligns an executable BO to its size, which still lets a size that is not a
+ * power of two cross a line; aligning to the next power of two (<= 16 MB) cannot. mali_va_alloc aligns page
+ * indices relative to MALI_VA_START, so that must itself sit on a 16 MB line for the alignment to be absolute.
+ */
+#define MALI_EXEC_WINDOW_PAGES  ((16ull << 20) / MALI_PG)
+_Static_assert(MALI_VA_START % (MALI_EXEC_WINDOW_PAGES * MALI_PG) == 0, "VA window start must be 16 MB aligned");
+
+/* alignment (4 KB pages) to pass mali_va_alloc for npages; 0 = an executable mapping that cannot fit one 16 MB window */
+static inline uint32_t
+mali_va_align(uint32_t npages, uint32_t base_align, uint32_t flags)
+{
+	if (!(flags & MALI_F_EXEC)) {
+		return base_align;
+	}
+	if (npages == 0 || npages > MALI_EXEC_WINDOW_PAGES) {
+		return 0;
+	}
+	uint32_t a = base_align;
+	while (a < npages) {
+		a <<= 1;
+	}
+	return a;
+}
+
+/* The whole VA decision of a GPU mapping of npages 4 KB pages with mapping flags (MALI_F_EXEC), so the host test covers what
+ * sweet_mali_map() does: 16 KB-aligned data, 16 MB-window executable. 0 and *va; -1 refused (an executable mapping larger than
+ * one 16 MB window, or npages 0): nothing allocated; -2 no free VA. */
+#define MALI_MAP_ALIGN_PAGES    4u              /* 16 KB: one XNU page */
+static inline int
+mali_va_alloc_map(struct mali_va *v, uint32_t npages, uint32_t flags, uint64_t *va)
+{
+	uint32_t a = npages ? mali_va_align(npages, MALI_MAP_ALIGN_PAGES, flags) : 0;
+	if (a == 0) {
+		return -1;
+	}
+	uint64_t x = mali_va_alloc(v, npages, a);
+	if (x == 0) {
+		return -2;
+	}
+	*va = x;
+	return 0;
+}
+
 /* 0 = freed, -1 = the range was not fully allocated or is outside the window (nothing changed) */
 static inline int
 mali_va_free(struct mali_va *v, uint64_t va, uint32_t npages)
