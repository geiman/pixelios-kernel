+/* ---- sec_ts (raven, /sweet-touch protocol = "sec_ts"; constants and cites in sweet_sec_ts.h) ---- */
+
+/* One chip-select assertion around len bytes, sent/received as FIFO-sized bursts with the chip select held low between them
+ * (as tg_xfer holds it across the FTM5 command and reply). Same chip-select timing as tg_xfer and the shim probe's
+ * cs_begin/cs_end, which read the S6SY79x on raven (touch-run1). tx NULL clocks out zeros, rx NULL drops the reply.
+ * Chunking a reply above 64 bytes is what the stock kernel does on raven (review 1 F1): its SPI11 has no dma-mode, so
+ * s3c64xx runs in CPU mode and splits a transfer into fifo_lvl = 64-byte chunks with flush_fifo() (channels off, SW_RST,
+ * drain) between them, under one manual chip select (spi-s3c64xx.c:1002-1011, :1105-1124, :1157-1158, kernel/gs
+ * 6e771b230c52; DT observed in device/google/raven/hardware/spi11-dt-2026-11-06.txt). */
+static int
+tg_cs_stream(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	unsigned off;
+	int err = 0;
+
+	tg_pin_put(&tg.cs, 0);
+	if (tg.cs_abl) {
+		tg_wr(tg.spi, SPI_CS_REG, tg_rd(tg.spi, SPI_CS_REG) & ~1u);
+	}
+	delay(1);
+	for (off = 0; !err && off < len; off += SPI_FIFO_BYTES) {
+		unsigned n = len - off > SPI_FIFO_BYTES ? SPI_FIFO_BYTES : len - off;
+		err = tg_spi_burst(tx ? tx + off : NULL, rx ? rx + off : NULL, n);
+	}
+	delay(FTM5_SPI_DELAY_CS_US);
+	tg_pin_put(&tg.cs, 1);
+	if (tg.cs_abl) {
+		tg_wr(tg.spi, SPI_CS_REG, tg_rd(tg.spi, SPI_CS_REG) | 1u);
+	}
+	delay(2);
+	return err;
+}
+
+/* sec_ts_read_internal (SPI build): the request in one chip select, the register's wait, the reply in a second one, checked
+ * as sec_ts does; up to SEC_TS_IO_RETRY_CNT (3, sec_ts.h:607) tries 1 ms apart. 0 = good frame (len data bytes in out),
+ * -1 = SPI burst timeout, -2 = bad frame after all tries, -3 = len out of range (nothing sent). */
+static int
+tg_sec_read(unsigned reg, uint8_t *out, unsigned len)
+{
+	uint8_t req[SEC_TS_REQ_LEN], rx[SEC_TS_MAX_EVENTS * SEC_TS_EVENT_SIZE + 8u];
+	unsigned n = sec_ts_reply_len(len), try;
+
+	if (len == 0 || n > sizeof(rx)) {
+		return -3;
+	}
+	sec_ts_read_req(req, reg, len);
+	for (try = 0; try < 3u; try++) {
+		if (try) {
+			delay(1000);
+		}
+		if (tg_cs_stream(req, NULL, sizeof(req))) {
+			return -1;
+		}
+		delay(reg == SEC_TS_READ_ALL_EVENT ? SEC_TS_DELAY_ALL_EVENT_US : SEC_TS_DELAY_US);
+		if (tg_cs_stream(NULL, rx, n)) {
+			return -1;
+		}
+		if (sec_ts_reply_ok(rx, reg, len)) {
+			memcpy(out, rx + SEC_TS_RD_HDR, len);
+			return 0;
+		}
+	}
+	return -2;
+}
+
+/* sec_ts_write (SPI build): the whole frame in one chip select. 0, or -1 on an SPI timeout / a frame too long. */
+static int
+tg_sec_write(unsigned reg, const uint8_t *data, unsigned len)
+{
+	uint8_t f[16];
+	unsigned n = sec_ts_write_frame(f, reg, data, len);
+
+	if (n == 0 || tg_cs_stream(f, NULL, n)) {
+		return -1;
+	}
+	return 0;
+}
+
+/* sec_ts_probe: reset low 10 ms, high, ~80 ms, then sec_ts_wait_for_ready(SEC_TS_ACK_BOOT_COMPLETE). Nothing reaches HID. */
+static bool
+tg_sec_reset_and_ready(unsigned *logged)
+{
+	tg_pin_put(&tg.reset, 0);
+	tg_pin_set_func(&tg.reset, PIN_FUNC_OUTPUT);
+	tg_sleep_ms(SEC_TS_RESET_LOW_MS);
+	tg_pin_put(&tg.reset, 1);
+	tg_sleep_ms(SEC_TS_BOOT_WAIT_MS);
+	for (unsigned i = 0; i < SEC_TS_READY_TRIES; i++) {
+		uint8_t e[SEC_TS_EVENT_SIZE];
+		int err = tg_sec_read(SEC_TS_READ_ONE_EVENT, e, sizeof(e));
+
+		if (err == -1) {
+			printf("SWEET TOUCH: sec_ts: SPI transfer timed out while waiting for boot-complete\n");
+			return false;
+		}
+		if (err == 0) {
+			if (e[0] != 0 && *logged < 200u) {
+				printf("SWEET TOUCH: boot ev %02x %02x %02x %02x %02x %02x %02x %02x (try %u)\n",
+				    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7], i);
+				(*logged)++;
+			}
+			if (sec_ts_boot_complete(e)) {
+				return true;
+			}
+		}
+		tg_sleep_ms(SEC_TS_READY_POLL_MS);
+	}
+	return false;
+}
+
+/* sec_ts_fw_init / sec_ts_read_information reads: device id, id, boot status (must be app mode), panel size. */
+static bool
+tg_sec_identify(void)
+{
+	uint8_t d[11];
+	unsigned px, py;
+	int err;
+
+	if ((err = tg_sec_read(SEC_TS_READ_DEVICE_ID, d, 5)) != 0) {
+		printf("SWEET TOUCH: sec_ts identify: DEVICE_ID read failed (%d: %s)\n", err,
+		    err == -1 ? "SPI timeout" : "no valid frame: rails off, in reset, wrong SPI mode or bus not ours?");
+		return false;
+	}
+	printf("SWEET TOUCH: sec_ts DEVICE_ID %02x %02x %02x %02x %02x\n", d[0], d[1], d[2], d[3], d[4]);
+	if (tg_sec_read(SEC_TS_READ_ID, d, 3) == 0) {
+		printf("SWEET TOUCH: sec_ts ID %02x %02x %02x\n", d[0], d[1], d[2]);
+	}
+	if (tg_sec_read(SEC_TS_READ_BOOT_STATUS, d, 1) != 0) {
+		printf("SWEET TOUCH: sec_ts identify: BOOT_STATUS read failed\n");
+		return false;
+	}
+	printf("SWEET TOUCH: sec_ts boot status %#x (%s)\n", d[0], d[0] == SEC_TS_STATUS_APP_MODE ? "app" :
+	    d[0] == SEC_TS_STATUS_BOOT_MODE ? "BOOTLOADER: firmware not running" : "unknown");
+	if (d[0] != SEC_TS_STATUS_APP_MODE) {
+		return false;
+	}
+	if (tg_sec_read(SEC_TS_READ_PANEL_INFO, d, sizeof(d)) == 0) {
+		sec_ts_panel_size(d, &px, &py);
+		printf("SWEET TOUCH: sec_ts panel %ux%u, tx %u rx %u (ADT max-coords %u,%u)\n", px, py, d[8], d[9],
+		    tg.max_x, tg.max_y);
+	}
+	return true;
+}
+
+/* sec_ts_fw_init (sec_ts.c:4378-4392): SET_TOUCHFUNCTION := (value read back, a little-endian u16) | TOUCH|PALM|WET, then
+ * SENSE_ON. Also the recovery after a firmware watchdog reset (sec_ts.c:3200-3210: Linux sends SENSE_ON, then sec_ts_reinit
+ * rewrites the touch function; here the order is that of the first start). */
+static bool
+tg_sec_enable(void)
+{
+	uint8_t f[2];
+	unsigned fn;
+
+	if (tg_sec_read(SEC_TS_CMD_SET_TOUCHFUNCTION, f, 2) != 0) {
+		printf("SWEET TOUCH: sec_ts: touch function read failed\n");
+		return false;
+	}
+	fn = ((unsigned)f[0] | (unsigned)f[1] << 8) | SEC_TS_SETFUNC_DEFAULT;
+	printf("SWEET TOUCH: sec_ts touch functions %02x%02x -> %04x, sense on\n", f[1], f[0], fn);
+	f[0] = (uint8_t)fn;
+	f[1] = (uint8_t)(fn >> 8);
+	return tg_sec_write(SEC_TS_CMD_SET_TOUCHFUNCTION, f, 2) == 0 && tg_sec_write(SEC_TS_CMD_SENSE_ON, NULL, 0) == 0;
+}
+
+static void
+tg_sec_handle(const uint8_t *e, unsigned *logged)
+{
+	struct sec_ts_ev ev = sec_ts_parse_event(e);
+
+	switch (ev.kind) {
+	case SEC_TS_DOWN:
+		tg.last_x[ev.id] = ftm5_scale(ev.x, (int)tg.max_x, (int)tg.width);
+		tg.last_y[ev.id] = ftm5_scale(ev.y, (int)tg.max_y, (int)tg.height);
+		tg.down[ev.id] = true;
+		sweet_hid_touch((int)ev.id, 1, tg.last_x[ev.id], tg.last_y[ev.id]);
+		break;
+	case SEC_TS_UP:
+	case SEC_TS_CANCEL:
+		if (tg.down[ev.id]) {
+			tg.down[ev.id] = false;
+			sweet_hid_touch((int)ev.id, 0, tg.last_x[ev.id], tg.last_y[ev.id]);
+		}
+		break;
+	case SEC_TS_STATUS:
+		if (sec_ts_watchdog_reset(e)) {
+			printf("SWEET TOUCH: sec_ts firmware watchdog reset: fingers released, sense on again\n");
+			tg_release_all();
+			tg.sec_reinit = true;
+		} else if (sec_ts_queue_full(e)) {
+			/* releases may have been dropped with the overflow: no finger may stay down in iOS (review 1 F3) */
+			printf("SWEET TOUCH: sec_ts controller event queue full: fingers released\n");
+			tg_release_all();
+		}
+		break;
+	case SEC_TS_NONE:
+		return;
+	default:
+		break;
+	}
+	if (ev.kind != SEC_TS_DOWN || *logged < 40u) {
+		if (*logged < 200u) {
+			printf("SWEET TOUCH: ev %02x %02x %02x %02x %02x %02x %02x %02x -> kind %d id %u type %u raw %d,%d\n",
+			    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7], (int)ev.kind, ev.id, ev.ttype, ev.x, ev.y);
+			(*logged)++;
+		}
+	}
+}
+
+/* sec_ts_read_event (sec_ts.c:3069-3180): READ_ONE_EVENT; empty if byte 0 is 0; byte 7 = events still queued, read with one
+ * READ_ALL_EVENT; more than 31 = overflow -> CLEAR_EVENT_STACK and nothing handled. -1 = bus error, else events handled. */
+static int
+tg_sec_drain(unsigned *logged)
+{
+	uint8_t buf[SEC_TS_MAX_EVENTS * SEC_TS_EVENT_SIZE];
+	unsigned left;
+
+	if (tg_sec_read(SEC_TS_READ_ONE_EVENT, buf, SEC_TS_EVENT_SIZE) != 0) {
+		return -1;
+	}
+	if (buf[0] == 0) {
+		return 0;
+	}
+	left = sec_ts_events_left(buf);
+	if (left >= SEC_TS_MAX_EVENTS) {
+		printf("SWEET TOUCH: sec_ts event buffer overflow, clearing\n");
+		(void)tg_sec_write(SEC_TS_CMD_CLEAR_EVENT_STACK, NULL, 0);
+		return 0;
+	}
+	if (left && tg_sec_read(SEC_TS_READ_ALL_EVENT, buf + SEC_TS_EVENT_SIZE, left * SEC_TS_EVENT_SIZE) != 0) {
+		return -1;
+	}
+	for (unsigned i = 0; i <= left; i++) {
+		tg_sec_handle(buf + i * SEC_TS_EVENT_SIZE, logged);
+	}
+	return (int)left + 1;
+}
