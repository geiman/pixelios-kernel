+/*
+ * Samsung sec_ts (S6SY79x, Pixel 6 Pro "raven") SPI wire protocol: the pure parts of the touch driver's sec_ts path
+ * (bsd/dev/sweet_touch_gs101.c, /sweet-touch "protocol" = "sec_ts"). No kernel headers, so shim/sweet_sec_ts_host_test.c
+ * builds this file with plain cc.
+ *
+ * Every constant is from Google's downstream driver, repo kernel/google-modules/touch/sec_touch, commit b23d1f8dfb9e
+ * (branch android-gs-raviole-5.10-android13-qpr3). "sec_ts.c:N" / "sec_ts.h:N" are lines of that tree. The driver is the
+ * SPI build (no I2C_INTERFACE). The same framing is observed on raven by the shim probe (device/google/raven/hardware/
+ * touch-run1-2026-11-05.txt: three reads accepted by sec_ts_reply_ok's rule, boot-complete event on the first poll).
+ */
+#ifndef SWEET_SEC_TS_H
+#define SWEET_SEC_TS_H
+
+#include <stdint.h>
+
+#define SEC_TS_SYNC              0xAAu  /* SEC_TS_SPI_SYNC_CODE, sec_ts.h:91 */
+#define SEC_TS_HDR               5u     /* SEC_TS_SPI_HEADER_SIZE, sec_ts.h:92 */
+#define SEC_TS_RD_HDR            7u     /* SEC_TS_SPI_READ_HEADER_SIZE, sec_ts.h:93 */
+#define SEC_TS_REQ_LEN           8u     /* read request: header 5 + reg 1 + checksum 1, padded to 4 (sec_ts.c:310-324) */
+#define SEC_TS_MAX_WRITE_DATA    8u     /* this driver writes at most 2 data bytes (SET_TOUCHFUNCTION) */
+
+/* registers (sec_ts.h) */
+#define SEC_TS_CMD_SENSE_ON          0x10u  /* sec_ts.h:209 */
+#define SEC_TS_READ_DEVICE_ID        0x22u  /* sec_ts.h:220, 5 bytes (sec_ts.c:4322) */
+#define SEC_TS_READ_PANEL_INFO       0x23u  /* sec_ts.h:221, 11 bytes (sec_ts.c:4112) */
+#define SEC_TS_CMD_SET_TOUCHFUNCTION 0x30u  /* sec_ts.h:225, 2 bytes (sec_ts.c:4160, 4379) */
+#define SEC_TS_READ_ID               0x52u  /* sec_ts.h:249, 3 bytes (sec_ts.c:4100) */
+#define SEC_TS_READ_BOOT_STATUS      0x55u  /* sec_ts.h:250, 1 byte */
+#define SEC_TS_READ_ONE_EVENT        0x60u  /* sec_ts.h:252 */
+#define SEC_TS_READ_ALL_EVENT        0x61u  /* sec_ts.h:253 */
+#define SEC_TS_CMD_CLEAR_EVENT_STACK 0x62u  /* sec_ts.h:254 */
+
+/* SEC_TS_DEFAULT_ENABLE_BIT_SETFUNC = TOUCH | PALM | WET (sec_ts.h:391-403), OR-ed into the value read back (sec_ts.c:4378) */
+#define SEC_TS_SETFUNC_DEFAULT       0x0061u
+
+/* sec_ts_spi_delay (sec_ts.c:59-97): wait between the request and the reply transfer */
+#define SEC_TS_DELAY_US              100u
+#define SEC_TS_DELAY_ALL_EVENT_US    550u
+
+#define SEC_TS_STATUS_BOOT_MODE  0x10u  /* sec_ts.h:338 */
+#define SEC_TS_STATUS_APP_MODE   0x20u  /* sec_ts.h:339 */
+
+#define SEC_TS_EVENT_SIZE        8u     /* SEC_TS_EVENT_BUFF_SIZE, sec_ts.h:350 */
+#define SEC_TS_MAX_EVENTS        32u    /* MAX_EVENT_COUNT, sec_ts.c:3068 */
+#define SEC_TS_TOUCH_ID_MAX      10u    /* MAX_SUPPORT_TOUCH_COUNT, sec_ts.h:135 */
+
+/* event id, byte 0 bits 1:0 (sec_ts.h:344-347, read at sec_ts.c:3173) */
+#define SEC_TS_EID_COORDINATE    0u
+#define SEC_TS_EID_STATUS        1u
+/* coordinate action, tchsta = byte 0 bits 7:6 (sec_ts.h:355-358) */
+#define SEC_TS_ACTION_PRESS      1u
+#define SEC_TS_ACTION_MOVE       2u
+#define SEC_TS_ACTION_RELEASE    3u
+/* touch type (sec_ts.h:360-369) */
+#define SEC_TS_TT_NORMAL         0u
+#define SEC_TS_TT_GLOVE          3u
+#define SEC_TS_TT_PALM           5u
+#define SEC_TS_TT_WET            6u
+#define SEC_TS_TT_GRIP           10u
+/* status event type = byte 0 bits 5:2, status id = byte 1 (struct sec_ts_event_status, sec_ts.h:812-827) */
+#define SEC_TS_STYPE_ERR         1u     /* TYPE_STATUS_EVENT_ERR, sec_ts.h:120 */
+#define SEC_TS_STYPE_INFO        2u     /* TYPE_STATUS_EVENT_INFO, sec_ts.h:121 */
+#define SEC_TS_STYPE_VENDOR_INFO 7u     /* TYPE_STATUS_EVENT_VENDOR_INFO, sec_ts.h:124 */
+#define SEC_TS_ACK_BOOT_COMPLETE 0x00u  /* sec_ts.h:372 */
+#define SEC_TS_ERR_QUEUE_FULL    0x01u  /* SEC_TS_ERR_EVENT_QUEUE_FULL, sec_ts.h:388 */
+#define SEC_TS_BOOT_WATCHDOG     0x20u  /* status_data_1 of a boot-complete event: "watchdog reset !?", sec_ts.c:3192-3204 */
+
+/* sec_ts_probe reset timing (sec_ts.c:4724-4733) and sec_ts_wait_for_ready (sec_ts.c:1089-1113, SEC_TS_WAIT_RETRY_CNT 100,
+ * sec_ts.h:608): READ_ONE_EVENT up to 100 times, 20 ms apart. The 80 ms after reset high is the shim's observed recipe
+ * (mdelay(10) + sec_ts_delay(70)). */
+#define SEC_TS_RESET_LOW_MS      10u
+#define SEC_TS_BOOT_WAIT_MS      80u
+#define SEC_TS_READY_TRIES       100u
+#define SEC_TS_READY_POLL_MS     20u
+
+/* Bytes clocked in for a read of len data bytes: header 7 + data + checksum 1, rounded up to 4 (sec_ts.c:326-328). */
+static inline unsigned
+sec_ts_reply_len(unsigned len)
+{
+	return (SEC_TS_RD_HDR + len + 1u + 3u) & ~3u;
+}
+
+/* Read request (sec_ts.c:310-324): AA 00 01 len_hi len_lo reg checksum 00, checksum = byte sum of the first six. */
+static inline void
+sec_ts_read_req(uint8_t *f, unsigned reg, unsigned len)
+{
+	unsigned i, sum = 0;
+
+	f[0] = SEC_TS_SYNC;
+	f[1] = 0x00;
+	f[2] = 0x01;
+	f[3] = (uint8_t)(len >> 8);
+	f[4] = (uint8_t)len;
+	f[5] = (uint8_t)reg;
+	for (i = 0; i < 6u; i++) {
+		sum += f[i];
+	}
+	f[6] = (uint8_t)sum;
+	f[7] = 0x00;
+}
+
+/*
+ * Write frame (sec_ts_write, sec_ts.c:162-183): AA, (len+1) big-endian, 00 00, reg, data, checksum over all bytes before it,
+ * zero padding to a multiple of 4. f must hold 16 bytes. Returns the frame length, or 0 if len is too long (nothing built).
+ */
+static inline unsigned
+sec_ts_write_frame(uint8_t *f, unsigned reg, const uint8_t *data, unsigned len)
+{
+	unsigned i, n, sum = 0;
+
+	if (len > SEC_TS_MAX_WRITE_DATA) {
+		return 0;
+	}
+	f[0] = SEC_TS_SYNC;
+	f[1] = (uint8_t)((len + 1u) >> 8);
+	f[2] = (uint8_t)(len + 1u);
+	f[3] = 0x00;
+	f[4] = 0x00;
+	f[5] = (uint8_t)reg;
+	for (i = 0; i < len; i++) {
+		f[SEC_TS_HDR + 1u + i] = data[i];
+	}
+	n = SEC_TS_HDR + 1u + len;
+	for (i = 0; i < n; i++) {
+		sum += f[i];
+	}
+	f[n++] = (uint8_t)sum;
+	while (n & 3u) {
+		f[n++] = 0x00;
+	}
+	return n;
+}
+
+/* sec_ts_read_internal's acceptance test (sec_ts.c:411-435): sync byte, register echoed at byte 5, byte sum of header and
+ * data equal to the checksum byte after them. Byte 6 (command status) is not checked there either (:431). Data at byte 7. */
+static inline int
+sec_ts_reply_ok(const uint8_t *r, unsigned reg, unsigned len)
+{
+	unsigned i, sum = 0;
+
+	for (i = 0; i < SEC_TS_RD_HDR + len; i++) {
+		sum += r[i];
+	}
+	return r[0] == SEC_TS_SYNC && r[5] == (uint8_t)reg && (uint8_t)sum == r[SEC_TS_RD_HDR + len];
+}
+
+/* sec_ts_wait_for_ready_with_count (sec_ts.c:1096-1110): INFO or VENDOR_INFO status type and byte 1 == the ack */
+static inline int
+sec_ts_boot_complete(const uint8_t *e)
+{
+	unsigned type = (e[0] >> 2) & 0xfu;
+
+	return (type == SEC_TS_STYPE_INFO || type == SEC_TS_STYPE_VENDOR_INFO) && e[1] == SEC_TS_ACK_BOOT_COMPLETE;
+}
+
+/* The firmware rebooted on its own (watchdog): a boot-complete INFO event with status_data_1 0x20 while running
+ * (sec_ts_read_event, sec_ts.c:3192-3204: Linux releases all fingers and sends SENSE_ON again). */
+static inline int
+sec_ts_watchdog_reset(const uint8_t *e)
+{
+	return (e[0] & 3u) == SEC_TS_EID_STATUS && ((e[0] >> 2) & 0xfu) == SEC_TS_STYPE_INFO &&
+	       e[1] == SEC_TS_ACK_BOOT_COMPLETE && e[2] == SEC_TS_BOOT_WATCHDOG;
+}
+
+/* The controller's event queue overflowed and dropped events, releases among them: Linux releases every finger
+ * (sec_ts_read_event, sec_ts.c:3232-3240: ERR status type, status id QUEUE_FULL). */
+static inline int
+sec_ts_queue_full(const uint8_t *e)
+{
+	return (e[0] & 3u) == SEC_TS_EID_STATUS && ((e[0] >> 2) & 0xfu) == SEC_TS_STYPE_ERR &&
+	       e[1] == SEC_TS_ERR_QUEUE_FULL;
+}
+
+/* Events queued behind this one: byte 7 bits 5:0 (sec_ts.c:3140). Returns SEC_TS_MAX_EVENTS (an overflow: Linux then sends
+ * CLEAR_EVENT_STACK, sec_ts.c:3142-3157) when it is above MAX_EVENT_COUNT - 1. */
+static inline unsigned
+sec_ts_events_left(const uint8_t *e)
+{
+	unsigned n = e[7] & 0x3fu;
+
+	return n > SEC_TS_MAX_EVENTS - 1u ? SEC_TS_MAX_EVENTS : n;
+}
+
+enum sec_ts_kind { SEC_TS_NONE, SEC_TS_DOWN, SEC_TS_UP, SEC_TS_CANCEL, SEC_TS_STATUS, SEC_TS_IGNORED };
+
+struct sec_ts_ev {
+	enum sec_ts_kind kind;
+	unsigned id;     /* 0-based (tid - 1) */
+	int x, y;
+	unsigned ttype;
+};
+
+/*
+ * Decode one 8-byte event. struct sec_ts_event_coordinate (sec_ts.h:832-845, GCC little-endian bitfields: first field =
+ * low bits): b0 = tchsta<<6 | tid<<2 | eid, x = b1<<4 | b3>>4, y = b2<<4 | (b3 & 0xf), ttype = (b6>>6)<<2 | b7>>6.
+ * Decoded as sec_ts_handle_coord_event (sec_ts.c:2017-2033). An all-zero byte 0 is the empty buffer (sec_ts.c:3134).
+ */
+static inline struct sec_ts_ev
+sec_ts_parse_event(const uint8_t *e)
+{
+	struct sec_ts_ev r = { SEC_TS_IGNORED, 0, 0, 0, 0 };
+	unsigned tid, action;
+
+	if (e[0] == 0) {
+		r.kind = SEC_TS_NONE;
+		return r;
+	}
+	if ((e[0] & 3u) == SEC_TS_EID_STATUS) {
+		r.kind = SEC_TS_STATUS;
+		return r;
+	}
+	if ((e[0] & 3u) != SEC_TS_EID_COORDINATE) {
+		return r;                 /* gesture / empty event ids (sec_ts.h:346-347): not used here */
+	}
+	tid = (e[0] >> 2) & 0xfu;
+	action = (e[0] >> 6) & 3u;
+	if (tid == 0 || tid - 1u >= SEC_TS_TOUCH_ID_MAX) {
+		return r;                 /* sec_ts.c:2017-2019 drops ids outside the table */
+	}
+	r.id = tid - 1u;
+	r.x = ((int)e[1] << 4) | (e[3] >> 4);
+	r.y = ((int)e[2] << 4) | (e[3] & 0x0fu);
+	r.ttype = ((unsigned)(e[6] >> 6) << 2) | (unsigned)(e[7] >> 6);
+	/* sec_ts_handle_coord_event reports only these five types, for every action (sec_ts.c:2059-2068); any other type
+	 * (hover, stylus, unknown) is ignored, its release included (review 1 F2). */
+	if (r.ttype != SEC_TS_TT_NORMAL && r.ttype != SEC_TS_TT_GLOVE && r.ttype != SEC_TS_TT_WET &&
+	    r.ttype != SEC_TS_TT_PALM && r.ttype != SEC_TS_TT_GRIP) {
+		return r;
+	}
+	if (action == SEC_TS_ACTION_RELEASE) {
+		r.kind = SEC_TS_UP;       /* every reported type releases (sec_ts.c:2070-2095) */
+	} else if (action == SEC_TS_ACTION_PRESS || action == SEC_TS_ACTION_MOVE) {
+		/* PALM / GRIP are reported as MT_TOOL_PALM (sec_ts.c:2148-2153): a cancel here */
+		r.kind = (r.ttype == SEC_TS_TT_PALM || r.ttype == SEC_TS_TT_GRIP) ? SEC_TS_CANCEL : SEC_TS_DOWN;
+	}
+	return r;
+}
+
+/* Panel size from READ_PANEL_INFO (sec_ts.c:4112, 4125-4130): x = b0<<8 | b1, y = b2<<8 | b3 (pixels, max = size - 1). */
+static inline void
+sec_ts_panel_size(const uint8_t *d, unsigned *x, unsigned *y)
+{
+	*x = ((unsigned)d[0] << 8) | d[1];
+	*y = ((unsigned)d[2] << 8) | d[3];
+}
+
+#endif /* SWEET_SEC_TS_H */
